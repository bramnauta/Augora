@page "/settings"
@attribute [Authorize(Roles = Roles.Admin)]
@inject ApiClient Api
@inject NotificationService Notifications
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Nav_Settings"] · AudioCentral</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Nav_Settings"]</RadzenText>

<RadzenCard Variant="Variant.Filled" Style="max-width: 50rem;">
    <RadzenText TextStyle="TextStyle.H6">@L["ManualDevices"]</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2">@L["ManualDevicesHelp"]</RadzenText>

    @if (_devices.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-my-4"><em>@L["NoManualDevices"]</em></RadzenText>
    }
    else
    {
        <RadzenStack Gap="0.25rem" class="rz-my-4">
            @foreach (var device in _devices)
            {
                <RadzenStack @key="device.Id" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="speaker" />
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0" Style="flex: 1;">@device.Name</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@device.Host:@device.Port</RadzenText>
                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@L["Remove"]" Click="@(() => RemoveAsync(device))" />
                </RadzenStack>
            }
        </RadzenStack>
    }

    <RadzenTemplateForm TItem="NewDevice" Data="@_new" Submit="AddAsync">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap" Gap="0.5rem">
            <RadzenFormField Text="@L["Name"]">
                <RadzenTextBox Name="Name" @bind-Value="_new.Name" />
            </RadzenFormField>
            <RadzenFormField Text="@L["Host"]">
                <RadzenTextBox Name="Host" @bind-Value="_new.Host" />
            </RadzenFormField>
            <RadzenFormField Text="@L["Port"]" Style="width: 8rem;">
                <RadzenNumeric Name="Port" TValue="int" @bind-Value="_new.Port" Min="1" Max="65535" ShowUpDown="false" />
            </RadzenFormField>
            <RadzenButton ButtonType="ButtonType.Submit" Icon="add" Text="@L["Add"]" Disabled="@(string.IsNullOrWhiteSpace(_new.Name) || string.IsNullOrWhiteSpace(_new.Host))" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenCard>

@code {
    private List<ManualCastDeviceDto> _devices = [];
    private NewDevice _new = new();

    protected override async Task OnInitializedAsync() => _devices = await Api.GetManualCastDevicesAsync();

    private async Task AddAsync(NewDevice device)
    {
        try
        {
            var added = await Api.AddManualCastDeviceAsync(new AddManualCastDeviceRequest(device.Name, device.Host, device.Port));
            _devices = [.. _devices, added];
            _new = new NewDevice();
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, L["Error"], ex.Message);
        }
    }

    private async Task RemoveAsync(ManualCastDeviceDto device)
    {
        try
        {
            await Api.RemoveManualCastDeviceAsync(device.Id);
            _devices = _devices.Where(d => d.Id != device.Id).ToList();
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, L["Error"], ex.Message);
        }
    }

    private sealed class NewDevice
    {
        public string Name { get; set; } = "";

        public string Host { get; set; } = "";

        public int Port { get; set; } = 8009;
    }
}
