@inject DialogService Dialogs
@inject IStringLocalizer<Strings> L

@* Asks an admin for a new password for UserName; closes with the password, or null when cancelled. *@
<form @onsubmit="@(() => Dialogs.Close(_password))" @onsubmit:preventDefault="true">
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@UserName</RadzenText>
        <RadzenFormField Text="@L["NewPassword"]">
            <ChildContent>
                <RadzenPassword @bind-Value="_password" autocomplete="new-password" autofocus />
            </ChildContent>
            <Helper>
                <RadzenText TextStyle="TextStyle.Caption">@L["PasswordHint"]</RadzenText>
            </Helper>
        </RadzenFormField>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="@L["Cancel"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => Dialogs.Close(null))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Disabled="@(_password.Length < 8)" />
        </RadzenStack>
    </RadzenStack>
</form>

@code {
    private string _password = "";

    [Parameter]
    public string UserName { get; set; } = "";
}
