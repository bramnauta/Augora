# Copy to .env and adjust to your network (used by docker-compose.yml).

# Host interface on the LAN (ip -br link); a VLAN interface such as eth0.20 also works.
LAN_PARENT=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
# A free address outside the DHCP pool; the UI and the stream endpoint live here on port 4727.
AUGORA_IP=192.168.1.250

MUSIC_PATH=/mnt/nas/music
PUBLIC_URL=
SPOTIFY_CLIENT_ID=
