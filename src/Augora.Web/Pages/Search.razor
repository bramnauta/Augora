@page "/search"
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Nav_Search"] · Augora</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Nav_Search"]</RadzenText>

<form @onsubmit="Submit" @onsubmit:preventDefault="true">
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-4">
        <RadzenTextBox @bind-Value="_input" Placeholder="@L["SearchPlaceholder"]" Style="flex: 1; max-width: 40rem;" autofocus />
        <RadzenButton ButtonType="ButtonType.Submit" Icon="search" Text="@L["Nav_Search"]" />
    </RadzenStack>
</form>

@if (_searching)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else if (_result is not null)
{
    @foreach (var error in _result.Errors)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">@error.ProviderName: @error.Error</RadzenAlert>
    }

    @if (_result.Items.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Body1">@L["NoResults"]</RadzenText>
    }
    else
    {
        <MediaItemList Items="@_result.Items" PlayFromHere="false" />
    }
}

@code {
    private string _input = "";
    private bool _searching;
    private SearchResultDto? _result;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private string? _searched;

    protected override async Task OnParametersSetAsync()
    {
        // Parameters are also set when the layout re-renders; only search when the query changed.
        if (Query == _searched)
        {
            return;
        }

        _searched = Query;
        _input = Query ?? "";
        _result = null;
        if (string.IsNullOrWhiteSpace(Query))
        {
            return;
        }

        _searching = true;
        try
        {
            _result = await Api.SearchAsync(Query);
        }
        finally
        {
            _searching = false;
        }
    }

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
        {
            Navigation.NavigateTo($"search?q={System.Uri.EscapeDataString(_input.Trim())}");
        }
    }
}
