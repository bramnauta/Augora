@page "/groups"
@implements IDisposable
@inject ApiClient Api
@inject PlayerStore Store
@inject NotificationService Notifications
@inject DialogService Dialogs
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Nav_Groups"] · Augora</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Nav_Groups"]</RadzenText>

<RadzenStack Gap="1.5rem" Style="max-width: 50rem;">
    <RadzenText TextStyle="TextStyle.Body2">@L["GroupsHelp"]</RadzenText>

    @if (_groups is null)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        @foreach (var group in _groups)
        {
            <RadzenCard @key="group.Id" Variant="Variant.Filled">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="speaker_group" />
                    <RadzenStack Gap="0" Style="flex: 1;" class="ellipsis">
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">@group.Name</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 ellipsis">@string.Join(", ", group.MemberIds.Select(PlayerName))</RadzenText>
                    </RadzenStack>
                    <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@L["Edit"]" Click="@(() => Edit(group))" />
                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@L["Delete"]" Click="@(() => DeleteAsync(group))" />
                </RadzenStack>
            </RadzenCard>
        }

        <RadzenCard Variant="Variant.Filled">
            <RadzenText TextStyle="TextStyle.H6">@(_editing is null ? L["GroupNew"] : L["GroupEdit", _editing.Name])</RadzenText>
            <RadzenStack Gap="0.75rem">
                <RadzenFormField Text="@L["Name"]" Style="max-width: 24rem;">
                    <RadzenTextBox @bind-Value="_name" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@L["GroupMembers"]</RadzenText>
                <RadzenCheckBoxList TValue="string" @bind-Value="_members" Orientation="Orientation.Vertical"
                                    Data="@Candidates" TextProperty="@nameof(PlayerDto.Name)" ValueProperty="@nameof(PlayerDto.Id)" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Icon="save" Text="@L["Save"]" Click="SaveAsync" Disabled="@(string.IsNullOrWhiteSpace(_name) || _members.Count() < 2)" />
                    @if (_editing is not null)
                    {
                        <RadzenButton Text="@L["Cancel"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="Reset" />
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private List<SyncGroupDto>? _groups;
    private SyncGroupDto? _editing;
    private string _name = "";
    private IEnumerable<string> _members = [];

    // Groups cannot contain groups (neither ours nor Cast groups would add anything).
    private IEnumerable<PlayerDto> Candidates => Store.Players.Where(p => p.Kind != PlayerKind.SyncGroup);

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await LoadAsync();
    }

    public void Dispose() => Store.Changed -= OnStoreChanged;

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        try
        {
            _groups = await Api.GetGroupsAsync();
        }
        catch (ApiException ex)
        {
            _groups = [];
            Notifications.Notify(NotificationSeverity.Error, L["Error"], ex.Message);
        }
    }

    private string PlayerName(string id) => Store.Players.FirstOrDefault(p => p.Id == id)?.Name ?? id;

    private void Edit(SyncGroupDto group)
    {
        _editing = group;
        _name = group.Name;
        _members = group.MemberIds.ToList();
    }

    private void Reset()
    {
        _editing = null;
        _name = "";
        _members = [];
    }

    private async Task SaveAsync()
    {
        try
        {
            await Api.SaveGroupAsync(_editing?.Id, new SaveSyncGroupRequest(_name, _members.ToList()));
            Notifications.Notify(NotificationSeverity.Success, L["Saved"], _name, duration: 2500);
            Reset();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, L["Error"], ex.Message);
        }
    }

    private async Task DeleteAsync(SyncGroupDto group)
    {
        if (await Dialogs.Confirm(L["ConfirmDeleteGroup", group.Name], L["Delete"]) != true)
        {
            return;
        }

        try
        {
            await Api.DeleteGroupAsync(group.Id);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, L["Error"], ex.Message);
        }
    }
}
