<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:Augora.Mobile.Views"
             xmlns:vm="clr-namespace:Augora.Mobile.ViewModels"
             x:Class="Augora.Mobile.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Padding="8,12,16,4" ColumnSpacing="4">
            <Grid x:Name="BackButton" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBack" />
                </Grid.GestureRecognizers>
                <v:Icon Kind="Back" />
            </Grid>
            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Title}" LineBreakMode="TailTruncation"
                   VerticalOptions="Center" Margin="8,0,0,0" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Refreshing="OnRefreshing" RefreshColor="{StaticResource Accent}">
            <CollectionView ItemsSource="{Binding Rows}">
                <CollectionView.EmptyView>
                    <Label Text="{Binding Error}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" Margin="32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaRow">
                        <v:MediaRowView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentView>
