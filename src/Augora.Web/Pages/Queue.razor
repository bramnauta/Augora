@page "/queue"
@implements IDisposable
@inject PlayerStore Store
@inject ApiClient Api
@inject NotificationService Notifications
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Nav_Queue"] · Augora</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">
        @L["Nav_Queue"]@(Store.SelectedPlayer is { } p ? $" · {p.Name}" : "")
    </RadzenText>
    @if (Store.SelectedPlayerId is not null)
    {
        var current = Store.SelectedQueue;
        var repeat = current?.Repeat ?? RepeatMode.Off;
        var repeatHint = L[$"Repeat_{repeat}"];
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
            <RadzenButton Icon="shuffle" Variant="Variant.Text" title="@L["Shuffle"]"
                          ButtonStyle="@(current?.Shuffle == true ? ButtonStyle.Primary : ButtonStyle.Base)"
                          Click="@(() => Run(id => Api.SetShuffleAsync(id, current?.Shuffle != true)))" />
            <RadzenButton Icon="@(repeat == RepeatMode.One ? "repeat_one" : "repeat")" Variant="Variant.Text" title="@repeatHint"
                          ButtonStyle="@(repeat != RepeatMode.Off ? ButtonStyle.Primary : ButtonStyle.Base)"
                          Click="@(() => Run(id => Api.SetRepeatAsync(id, NextRepeat(repeat))))" />
            <RadzenButton Icon="radio" Text="@L["Autoplay"]" Variant="Variant.Text" title="@L["AutoplayHint"]"
                          ButtonStyle="@(current?.Autoplay == true ? ButtonStyle.Primary : ButtonStyle.Base)"
                          Click="@(() => Run(id => Api.SetAutoplayAsync(id, current?.Autoplay != true)))" />
            @if (current is { Items.Count: > 0 })
            {
                <RadzenButton Icon="clear_all" Text="@L["ClearQueue"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                              Click="@(() => Run(id => Api.ClearQueueAsync(id)))" />
            }
        </RadzenStack>
    }
</RadzenStack>

@if (Store.SelectedPlayerId is null)
{
    <RadzenText TextStyle="TextStyle.Body1">@L["NoPlayerSelected"]</RadzenText>
}
else if (Store.SelectedQueue is not { Items.Count: > 0 } queue)
{
    <RadzenText TextStyle="TextStyle.Body1" class="rz-mt-4">@L["QueueEmpty"]</RadzenText>
}
else
{
    <RadzenStack Gap="0.25rem" class="rz-mt-4">
        @for (var i = 0; i < queue.Items.Count; i++)
        {
            var entry = queue.Items[i];
            var isCurrent = i == queue.CurrentIndex;
            <RadzenStack @key="entry.Id" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem"
                         class="@($"media-row {(isCurrent ? "current" : "")}")" @onclick="@(() => Run(id => Api.PlayQueueItemAsync(id, entry.Id)))">
                <MediaImage Url="@entry.Item.ImageUrl" Icon="@MediaItemList.TypeIcon(entry.Item.Type)" />
                <RadzenStack Gap="0" class="ellipsis" Style="flex: 1;">
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0 ellipsis">@entry.Item.Name</RadzenText>
                    @if (!string.IsNullOrEmpty(entry.Item.Subtitle))
                    {
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 ellipsis">@entry.Item.Subtitle</RadzenText>
                    }
                </RadzenStack>
                <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@L["Remove"]"
                              Click="@(() => Run(id => Api.RemoveQueueItemAsync(id, entry.Id)))" @onclick:stopPropagation="true" />
            </RadzenStack>
        }
    </RadzenStack>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await Store.RefreshQueueAsync();
    }

    private async Task Run(Func<string, Task> action)
    {
        if (Store.SelectedPlayerId is not { } id)
        {
            return;
        }

        try
        {
            await action(id);
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, L["Error"], ex.Message, duration: 8000);
        }
    }

    private static RepeatMode NextRepeat(RepeatMode mode) => mode switch
    {
        RepeatMode.Off => RepeatMode.All,
        RepeatMode.All => RepeatMode.One,
        _ => RepeatMode.Off,
    };

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnChanged;
}
