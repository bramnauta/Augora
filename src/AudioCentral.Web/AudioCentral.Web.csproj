<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- Needed to switch between nl and en at runtime -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioCentral.Contracts\AudioCentral.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      No trimming: the contracts are deserialised with reflection (HttpClient, SignalR, JS interop) and
      Radzen uses reflection too; trimmed builds failed with DeserializeNoConstructor. For a self-hosted
      app the larger (brotli-compressed, cached) download is the better trade-off.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

</Project>
