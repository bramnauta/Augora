@page "/users"
@attribute [Authorize(Roles = Roles.Admin)]
@inject ApiClient Api
@inject DialogService Dialogs
@inject NotificationService Notifications
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Nav_Users"] · Augora</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Nav_Users"]</RadzenText>

<RadzenStack Gap="1.5rem" Style="max-width: 50rem;">
    <RadzenCard Variant="Variant.Filled">
        <RadzenStack Gap="0.5rem">
            @foreach (var user in _users)
            {
                <RadzenStack @key="user.Id" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                    <RadzenIcon Icon="@(user.IsAdmin ? "admin_panel_settings" : "person")" />
                    <RadzenStack Gap="0" Style="flex: 1; min-width: 10rem;">
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">@(user.DisplayName ?? user.UserName)</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@user.UserName · @(user.IsAdmin ? L["Admin"] : L["RegularUser"])</RadzenText>
                    </RadzenStack>
                    <RadzenSwitch Value="@user.IsAdmin" Change="@(v => UpdateAsync(user, new UpdateUserRequest(IsAdmin: v)))"
                                  Disabled="@(user.Id == _currentUserId)" title="@(user.Id == _currentUserId ? L["CannotChangeSelf"] : L["Admin"])" />
                    <RadzenButton Icon="password" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@L["ResetPassword"]" Click="@(() => ResetPasswordAsync(user))" />
                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="@(user.Id == _currentUserId)"
                                  title="@(user.Id == _currentUserId ? L["CannotChangeSelf"] : L["Delete"])" Click="@(() => DeleteAsync(user))" />
                </RadzenStack>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard Variant="Variant.Filled">
        <RadzenText TextStyle="TextStyle.H6">@L["NewUser"]</RadzenText>
        <form @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenFormField Text="@L["UserName"]">
                    <RadzenTextBox @bind-Value="_new.UserName" autocomplete="off" />
                </RadzenFormField>
                <RadzenFormField Text="@L["DisplayName"]">
                    <RadzenTextBox @bind-Value="_new.DisplayName" autocomplete="off" />
                </RadzenFormField>
                <RadzenFormField Text="@L["Password"]">
                    <RadzenPassword @bind-Value="_new.Password" autocomplete="new-password" />
                </RadzenFormField>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-mb-2">
                    <RadzenCheckBox @bind-Value="_new.IsAdmin" Name="newIsAdmin" />
                    <RadzenLabel Text="@L["Admin"]" Component="newIsAdmin" />
                </RadzenStack>
                <RadzenButton ButtonType="ButtonType.Submit" Icon="person_add" Text="@L["Add"]"
                              Disabled="@(string.IsNullOrWhiteSpace(_new.UserName) || _new.Password.Length < 8)" />
            </RadzenStack>
        </form>
    </RadzenCard>
</RadzenStack>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private List<UserDto> _users = [];
    private NewUser _new = new();
    private string? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            _currentUserId = (await AuthState).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        _users = await Api.GetUsersAsync();
    }

    private Task CreateAsync() => RunAsync(async () =>
    {
        var user = await Api.CreateUserAsync(new CreateUserRequest(_new.UserName, _new.Password, NullIfEmpty(_new.DisplayName), _new.IsAdmin));
        _users = [.. _users, user];
        _new = new NewUser();
    });

    private Task UpdateAsync(UserDto user, UpdateUserRequest request) => RunAsync(async () =>
    {
        var updated = await Api.UpdateUserAsync(user.Id, request);
        _users = _users.Select(u => u.Id == updated.Id ? updated : u).ToList();
    });

    private async Task ResetPasswordAsync(UserDto user)
    {
        var password = await Dialogs.OpenAsync<PasswordDialog>(L["ResetPassword"], new Dictionary<string, object?> { [nameof(PasswordDialog.UserName)] = user.UserName });
        if (password is string newPassword)
        {
            await UpdateAsync(user, new UpdateUserRequest(NewPassword: newPassword));
            Notifications.Notify(NotificationSeverity.Success, L["PasswordChanged"]);
        }
    }

    private async Task DeleteAsync(UserDto user)
    {
        if (await Dialogs.Confirm(L["ConfirmDeleteUser", user.UserName], L["Delete"], new ConfirmOptions { OkButtonText = L["Delete"], CancelButtonText = L["Cancel"] }) != true)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Api.DeleteUserAsync(user.Id);
            _users = _users.Where(u => u.Id != user.Id).ToList();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, L["Error"], ex.Message, duration: 8000);
            _users = await Api.GetUsersAsync();
        }
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private sealed class NewUser
    {
        public string UserName { get; set; } = "";

        public string DisplayName { get; set; } = "";

        public string Password { get; set; } = "";

        public bool IsAdmin { get; set; }
    }
}
