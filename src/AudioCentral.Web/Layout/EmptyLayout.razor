@inherits LayoutComponentBase

<RadzenComponents />

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1rem;">
    <RadzenCard Variant="Variant.Filled" Style="width: 100%; max-width: 26rem;">
