@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject ApiClient Api
@inject ServerAuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Login"] · Augora</PageTitle>

@if (_status is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    @if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">@_error</RadzenAlert>
    }

    <form @onsubmit="LoginAsync" @onsubmit:preventDefault="true">
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="@L["UserName"]" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="_userName" autocomplete="username" autofocus Style="width: 100%;" />
            </RadzenFormField>
            <RadzenFormField Text="@L["Password"]" Variant="Variant.Outlined">
                <RadzenPassword @bind-Value="_password" autocomplete="current-password" Style="width: 100%;" />
            </RadzenFormField>
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Login"]" IsBusy="@_busy" Disabled="@(string.IsNullOrWhiteSpace(_userName) || string.IsNullOrEmpty(_password))" />
        </RadzenStack>
    </form>

    @if (_status.ExternalProviders.Count > 0)
    {
        <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center" class="rz-my-3">@L["Or"]</RadzenText>
        <RadzenStack Gap="0.5rem">
            @foreach (var provider in _status.ExternalProviders)
            {
                <RadzenButton Variant="Variant.Outlined" Icon="login" Text="@L["LoginWith", provider.DisplayName]"
                              Click="@(() => Navigation.NavigateTo($"api/auth/external/{provider.Scheme}?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}", forceLoad: true))" />
            }
        </RadzenStack>
    }
}

@code {
    private AuthStatusDto? _status;
    private string _userName = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? ExternalError { get; set; }

    private string SafeReturnUrl => ReturnUrl is { } url && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/login") ? url : "/";

    protected override async Task OnInitializedAsync()
    {
        // No Auth.Refresh() here: notifying a state change re-creates this page and loops.
        // Logging out reloads the app, so the cached status is current.
        _status = await Auth.GetStatusAsync();
        if (_status.SetupRequired)
        {
            Navigation.NavigateTo("setup");
        }
        else if (_status.User is not null)
        {
            Navigation.NavigateTo(SafeReturnUrl);
        }
        else if (ExternalError is not null)
        {
            _error = L["ExternalLoginFailed"];
        }
    }

    private async Task LoginAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.LoginAsync(_userName, _password);
            // Full reload: starts the hub connection and the player store with the new cookie.
            Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _password = "";
        }
        finally
        {
            _busy = false;
        }
    }
}
