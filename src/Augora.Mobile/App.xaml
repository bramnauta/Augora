<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Augora.Mobile.App"
             UserAppTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Background">#121212</Color>
            <Color x:Key="Surface">#1E1E1E</Color>
            <Color x:Key="SurfaceRaised">#2A2A2A</Color>
            <Color x:Key="Accent">#B388FF</Color>
            <Color x:Key="OnAccent">#1A0B33</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#B3B3B3</Color>
            <Color x:Key="Danger">#FF6B6B</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>
            <Style x:Key="Secondary" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="Title" TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="24,0" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
            <Style x:Key="Quiet" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Accent}" />
            </Style>
            <Style TargetType="Slider">
                <Setter Property="MinimumTrackColor" Value="{StaticResource Accent}" />
                <Setter Property="MaximumTrackColor" Value="{StaticResource SurfaceRaised}" />
                <Setter Property="ThumbColor" Value="{StaticResource Accent}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
