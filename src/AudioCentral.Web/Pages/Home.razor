@page "/"
@implements IDisposable
@inject PlayerStore Store
@inject ApiClient Api
@inject NotificationService Notifications
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Nav_Players"] · AudioCentral</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Nav_Players"]</RadzenText>

@if (Store.Players.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">@L["NoPlayers"]</RadzenAlert>
}
else
{
    <RadzenRow Gap="1rem">
        @foreach (var player in Store.Players)
        {
            <RadzenColumn @key="player.Id" Size="12" SizeMD="6" SizeXL="4">
                <RadzenCard Variant="Variant.Filled" Style="@(player.Id == Store.SelectedPlayerId ? "outline: 2px solid var(--rz-primary);" : "")">
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenBadge BadgeStyle="BadgeStyle.Base" Variant="Variant.Outlined" Text="@L[$"Kind_{player.Kind}"]" />
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                @if (player.Id != Store.SelectedPlayerId)
                                {
                                    <RadzenButton Text="@L["SelectPlayer"]" Size="ButtonSize.Small" Variant="Variant.Text" Click="@(() => Store.SelectPlayerAsync(player.Id))" />
                                }
                                @if (player.Provider == "remote" && !player.Available)
                                {
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@L["ForgetPlayer"]"
                                                  Click="@(() => ForgetAsync(player))" />
                                }
                            </RadzenStack>
                        </RadzenStack>
                        <NowPlayingInfo Player="@player" />
                        <PlayerControls Player="@player" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>
}

@code {
    protected override void OnInitialized() => Store.Changed += OnChanged;

    private async Task ForgetAsync(PlayerDto player)
    {
        try
        {
            await Api.ForgetPlayerAsync(player.Id);
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, L["Error"], ex.Message);
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnChanged;
}
